# ─────────────────────────────────────────────────────────────────────────────
# TaxFlow CRM — Environment Configuration
# Copy this file to .env and fill in your values.
# ─────────────────────────────────────────────────────────────────────────────

# ─── Security ─────────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=taxflow.db

# ─── AI Assistant ─────────────────────────────────────────────────────────────
# OpenAI (default)
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# DeepSeek (alternative — set AI_PROVIDER=deepseek to use)
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# AI_PROVIDER options: openai | deepseek
AI_PROVIDER=openai

# ─── Email (Optional — logs to console if not set) ────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@taxflow.app
EMAIL_ENABLED=false

# ─── App Settings ─────────────────────────────────────────────────────────────
APP_NAME=TaxFlow CRM
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=false

# ─── Default Admin User (created on first startup) ────────────────────────────
ADMIN_EMAIL=admin@taxflow.app
ADMIN_PASSWORD=
